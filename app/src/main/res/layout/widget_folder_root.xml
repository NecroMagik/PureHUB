<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/folder_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <!-- 1. Подложка папки -->
    <ImageView
        android:id="@+id/folder_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <!-- 2. Заглушка для пустой папки -->
    <TextView
        android:id="@+id/folder_empty_hint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="8dp"
        android:text="+ Настроить\nпапку"
        android:textColor="#CC00E676"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 3. Режим 1x1 -->
    <ImageView
        android:id="@+id/folder_1x1_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- 4. Основной контейнер со свайпом вверх/вниз -->
    <LinearLayout
        android:id="@+id/folder_content_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/folder_title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="2dp"
            android:singleLine="true"
            android:textColor="#E6FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Свайп-контейнер вверх/вниз -->
        <ListView
            android:id="@+id/folder_vertical_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="true"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <!-- Нижняя панель: поднята выше от края (paddingBottom="8dp" у родителя + height="22dp"),
             чтобы в 1x2 и 2x2 точки и шестеренка были четко видны -->
        <RelativeLayout
            android:id="@+id/folder_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="2dp">

            <LinearLayout
                android:id="@+id/folder_pager_touch_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toStartOf="@id/btn_folder_settings"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_prev_tab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/slide_dots_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="10dp"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/btn_next_tab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_folder_settings"
                android:layout_width="22dp"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:text="⚙️"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>